<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Od Androida 13 powiadomienie o nowym zamowieniu wymaga zgody uzytkownika. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SklepAplikacja"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/reguly_kopii"
        android:networkSecurityConfig="@xml/siec"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FWDrucikSklep">

        <!-- Udostepnia aparatowi miejsce na zdjecie. `authorities` musi byc
             unikalne w systemie, stad identyfikator pakietu w nazwie. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pliki"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pliki" />
        </provider>

        <activity
            android:name=".GlownaAktywnosc"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FWDrucikSklep">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
