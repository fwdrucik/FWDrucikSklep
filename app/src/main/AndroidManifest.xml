<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Od Androida 13 powiadomienie o nowym zamowieniu wymaga zgody uzytkownika. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application
        android:name=".SklepAplikacja"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/reguly_kopii"
        android:networkSecurityConfig="@xml/siec"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FWDrucikSklep">

        <!-- Udostepnia aparatowi miejsce na zdjecie. `authorities` musi byc
             unikalne w systemie, stad identyfikator pakietu w nazwie. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pliki"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pliki" />
        </provider>

        <activity
            android:name=".GlownaAktywnosc"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FWDrucikSklep">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".KreatorAktywnosc"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.FWDrucikSklep" />

        <!-- Przyjmuje klucz Gemini z komputera przez adb. Tylko zapis, nigdy odczyt -
             szczegoly i uzasadnienie `exported` w OdbiorKlucza.kt. -->
        <receiver
            android:name=".praca.OdbiorKlucza"
            android:exported="true">
            <intent-filter>
                <action android:name="pl.fwdrucik.sklep.USTAW_KLUCZ" />
            </intent-filter>
        </receiver>

        <!-- Push o zamowieniach. Odpytywanie co 15 minut zostaje jako droga
             zapasowa - patrz UslugaPowiadomien.kt. -->
        <service
            android:name=".praca.UslugaPowiadomien"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Kafelek na pulpicie: godzina, data i nowe zamowienia. -->
        <receiver
            android:name=".praca.WidgetSklepu"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sklep_info" />
        </receiver>
    </application>
</manifest>
